<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KopolArt.Mobile.ViewModels"
             xmlns:models="clr-namespace:KopolArt.Mobile.Models"
             xmlns:presentation="clr-namespace:KopolArt.Mobile.Presentation"
             xmlns:helpers="clr-namespace:KopolArt.Mobile.Helpers"
             x:Class="KopolArt.Mobile.Views.DownloadHistoryPage"
             x:DataType="vm:DownloadHistoryViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BrandBackground}, Dark={StaticResource BrandBackgroundDark}}"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,14,16,16" RowSpacing="12">
        <!-- 1. Top Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
            <!-- Back Button -->
            <Border Style="{StaticResource TopBarBackButtonStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static helpers:KopolArtFaIcons.Back}"
                       Style="{StaticResource TopBarBackIconStyle}" />
            </Border>

            <!-- Title -->
            <Label Grid.Column="1"
                   Text="سوابق دانلود فایل‌ها"
                   Style="{StaticResource TopBarTitleStyle}" />

            <!-- Clear All Downloads Button -->
            <Button Grid.Column="2"
                    Text="پاک‌سازی کل"
                    Command="{Binding ClearAllCommand}"
                    Style="{StaticResource TopBarDestructiveButtonStyle}" />
        </Grid>

        <!-- 2. Summary Statistics Card -->
        <Border Grid.Row="1" Style="{StaticResource LuxuryCardStyle}" Padding="16">
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="تعداد کل دانلودها:"
                           FontSize="12"
                           FontFamily="KopolFontMedium"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                    <Label Text="{Binding TotalDownloadCount}"
                           FontSize="14"
                           FontFamily="KopolFontBlack"
                           TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}" />
                </VerticalStackLayout>

                <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="40" Color="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}" />

                <VerticalStackLayout Grid.Column="2" Spacing="4">
                    <Label Text="مجموع حجم فایل‌ها:"
                           FontSize="12"
                           FontFamily="KopolFontMedium"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                    <Label Text="{Binding TotalDownloadVolume}"
                           FontSize="14"
                           FontFamily="KopolFontBlack"
                           TextColor="{AppThemeBinding Light={StaticResource BrandSecondary}, Dark={StaticResource BrandAccent}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- 3. Search & Sort Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border Grid.Column="0"
                    Style="{StaticResource SearchCardStyle}">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="{x:Static helpers:KopolArtFaIcons.Search}"
                           Style="{StaticResource SearchIconStyle}" />
                    <Entry Grid.Column="1"
                           Text="{Binding SearchText}"
                           Placeholder="جستجو در دانلودها..."
                           Style="{StaticResource SearchEntryStyle}" />
                </Grid>
            </Border>

            <!-- Sort Button -->
            <Border Grid.Column="1"
                    Style="{StaticResource SortButtonCardStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeSortCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="{x:Static helpers:KopolArtFaIcons.SortAltDown}"
                           Style="{StaticResource SortIconStyle}" />
                    <Label Text="{Binding CurrentSortTitle}"
                           Style="{StaticResource SortLabelStyle}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- 4. Category Filter Chips Bar -->
        <ScrollView Grid.Row="3" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding CategoryFilters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryFilterOption">
                        <Border StrokeThickness="1.2"
                                Padding="14,6"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" />
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource FilterChipBorderLight}, Dark={StaticResource FilterChipBorderDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadHistoryViewModel}}, Path=SelectCategoryCommand}"
                                                      CommandParameter="{Binding Name}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name}"
                                   FontFamily="KopolFontBold"
                                   FontSize="12">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 5. List View / Empty View -->
        <Grid Grid.Row="4">
            <!-- Empty State -->
            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12"
                                 ZIndex="2">
                <Border Style="{StaticResource EmptyStateCircleBorderStyle}">
                    <Label Text="{x:Static helpers:KopolArtFaIcons.DownloadCloud}"
                           Style="{StaticResource EmptyStateIconLabelStyle}" />
                </Border>
                <Label Text="سابقه‌ای برای دانلود یافت نشد"
                       Style="{StaticResource EmptyStateTitleLabelStyle}" />
                <Label Text="فایل‌هایی که از سایت دانلود می‌کنید در این بخش نمایش داده می‌شوند."
                       Style="{StaticResource EmptyStateDescriptionLabelStyle}" />
                <Button Text="کاوش در مطالب سایت"
                        Command="{Binding ExploreWebsiteCommand}"
                        Style="{StaticResource EmptyStateActionButtonStyle}" />
            </VerticalStackLayout>

            <!-- Downloads List -->
            <CollectionView ItemsSource="{Binding DownloadGroups}"
                            IsVisible="{Binding IsNotEmpty}"
                            IsGrouped="True"
                            VerticalScrollBarVisibility="Never"
                            SelectionMode="None">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:DownloadDateGroup">
                        <Grid ColumnDefinitions="Auto,Auto,*"
                              Padding="4,12,4,6"
                              ColumnSpacing="8"
                              VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding GroupIcon}"
                                       FontFamily="KopolArtFa"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding GroupTitle}"
                                       Style="{StaticResource DateGroupHeaderTitleStyle}" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1"
                                    Style="{StaticResource DateGroupHeaderBadgeStyle}">
                                <Label Text="{Binding CountBadgeText}"
                                       Style="{StaticResource DateGroupHeaderBadgeLabelStyle}" />
                            </Border>
                            <BoxView Grid.Column="2"
                                     Style="{StaticResource DateGroupHeaderDividerStyle}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="presentation:DownloadDisplayItem">
                        <SwipeView Threshold="30">
                            <!-- Left Swipe Action (Revealed when swiping to the Right): Share -->
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadHistoryViewModel}}, Path=ShareItemCommand}"
                                                   CommandParameter="{Binding .}">
                                        <Border Style="{StaticResource SwipeActionShareBorderStyle}">
                                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                                <Label Text="{x:Static helpers:KopolArtFaIcons.ShareSquared}"
                                                       Style="{StaticResource SwipeActionIconLabelStyle}" />
                                                <Label Text="اشتراک"
                                                       Style="{StaticResource SwipeActionTextLabelStyle}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <!-- Right Swipe Action (Revealed when swiping to the Left): Delete -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadHistoryViewModel}}, Path=DeleteItemCommand}"
                                                   CommandParameter="{Binding .}">
                                        <Border Style="{StaticResource SwipeActionDeleteBorderStyle}">
                                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                                <Label Text="{x:Static helpers:KopolArtFaIcons.Trash}"
                                                       Style="{StaticResource SwipeActionIconLabelStyle}" />
                                                <Label Text="حذف"
                                                       Style="{StaticResource SwipeActionTextLabelStyle}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="4,2,4,14">
                            <Border Style="{StaticResource LuxuryCardStyle}"
                                    Padding="14,12">

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                <!-- Top Row: Category Badge, File Name & Delete Button -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                Style="{StaticResource ItemCategoryBadgeBorderStyle}"
                                                BackgroundColor="{Binding BadgeBackgroundColor}"
                                                Stroke="{Binding BadgeBorderColor}">
                                            <Label Text="{Binding CategoryName}"
                                                   Style="{StaticResource ItemCategoryBadgeLabelStyle}"
                                                   TextColor="{Binding BadgeTextColor}" />
                                        </Border>

                                        <Label Grid.Column="1"
                                               Text="{Binding FileName}"
                                               Style="{StaticResource ItemTitleLabelStyle}"
                                               LineBreakMode="MiddleTruncation"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Delete single item -->
                                    <Border Grid.Column="1"
                                            Style="{StaticResource CardDeleteButtonBorderStyle}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadHistoryViewModel}}, Path=DeleteItemCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{x:Static helpers:KopolArtFaIcons.Trash}"
                                               Style="{StaticResource CardDeleteIconLabelStyle}" />
                                    </Border>
                                </Grid>

                                <!-- Middle Row: Size, Date & Existence Status -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding FormattedSize}"
                                               Style="{StaticResource ItemTimeLabelStyle}" />
                                        <Label Text="-"
                                               Style="{StaticResource ItemDotSeparatorLabelStyle}" />
                                        <Label Text="{Binding FormattedDate}"
                                               Style="{StaticResource ItemDateLabelStyle}"
                                               LineBreakMode="TailTruncation" />
                                    </HorizontalStackLayout>

                                    <!-- Status Badge -->
                                    <Label Grid.Column="1"
                                           Text="{Binding StatusText}"
                                           FontSize="11"
                                           FontFamily="KopolFontBold"
                                           TextColor="{Binding StatusColor}"
                                           VerticalOptions="Center"
                                           LineBreakMode="NoWrap" />
                                </Grid>

                                <!-- Storage Location Row -->
                                <Border Grid.Row="2"
                                        IsVisible="{Binding HasStorageLocation}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                        Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                                        StrokeThickness="0.8"
                                        Padding="10,6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <Label Grid.Column="0"
                                               Text="{x:Static helpers:KopolArtFaIcons.FolderOpen}"
                                               FontFamily="KopolArtFa"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding StorageLocationDescription}"
                                               FontSize="11"
                                               FontFamily="KopolFontMedium"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="2"
                                                BackgroundColor="Transparent"
                                                StrokeThickness="0"
                                                Padding="4,2"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadHistoryViewModel}}, Path=CopyPathCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{x:Static helpers:KopolArtFaIcons.Copy}"
                                                       FontFamily="KopolArtFa"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                       VerticalOptions="Center" />
                                                <Label Text="کپی مسیر"
                                                       FontSize="10"
                                                       FontFamily="KopolFontBold"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Wallpaper Action: only for downloaded wallpaper images verified as usable portraits -->
                                <Button Grid.Row="3"
                                        Text="تنظیم به‌عنوان پس‌زمینه گوشی"
                                        IsVisible="{Binding CanSetAsWallpaper}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadHistoryViewModel}}, Path=SetWallpaperCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource LuxuryAccentButtonStyle}" />

                                <!-- Bottom Row: Action Buttons -->
                                <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                                    <!-- Open File Button -->
                                    <Button Grid.Column="0"
                                            Text="باز کردن فایل"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadHistoryViewModel}}, Path=OpenFileCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding FileExistsLocally}"
                                            Style="{StaticResource LuxuryPrimaryButtonStyle}"
                                            HeightRequest="38" />

                                    <!-- Redownload Button -->
                                    <Button Grid.Column="1"
                                            Text="دانلود مجدد"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadHistoryViewModel}}, Path=RedownloadCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource LuxuryGhostButtonStyle}"
                                            HeightRequest="38" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                        </SwipeView>
                    </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
