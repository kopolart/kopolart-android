<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KopolArt.Mobile.ViewModels"
             xmlns:models="clr-namespace:KopolArt.Mobile.Models"
             xmlns:helpers="clr-namespace:KopolArt.Mobile.Helpers"
             x:Class="KopolArt.Mobile.Views.UpdatesHistoryPage"
             x:DataType="vm:UpdatesHistoryViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BrandBackground}, Dark={StaticResource BrandBackgroundDark}}"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,14,16,16" RowSpacing="12">

        <!-- 1. Top Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
            <!-- Back Button -->
            <Border Style="{StaticResource TopBarBackButtonStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static helpers:KopolArtFaIcons.Back}"
                       Style="{StaticResource TopBarBackIconStyle}" />
            </Border>

            <!-- Title -->
            <Label Grid.Column="1"
                   Style="{StaticResource TopBarTitleStyle}"
                   Text="تاریخچه تغییرات برنامه" />
        </Grid>

        <!-- 2. Current App Version Banner -->
        <Border Grid.Row="1"
                Style="{StaticResource LuxuryCardStyle}"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                <Border Style="{StaticResource CardRowIconBorderStyle}">
                    <Label Style="{StaticResource CardRowIconLabelStyle}"
                           Text="{x:Static helpers:KopolArtFaIcons.Verified}"
                           TextColor="{StaticResource BrandPrimary}" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding CurrentAppVersion}"
                           FontSize="13.5"
                           FontFamily="KopolFontBlack"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="تمام تغییرات، قابلیت‌ها و رفع باگ‌های نسخه‌های مختلف کپل‌آرت"
                           FontSize="11"
                           FontFamily="KopolFontMedium"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- 3. Main Content: Loading, Error or List -->
        <Grid Grid.Row="2">

            <!-- Loading State -->
            <VerticalStackLayout IsVisible="{Binding IsLoading}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Color="{StaticResource BrandPrimary}"
                                   WidthRequest="40"
                                   HeightRequest="40" />
                <Label Text="در حال دریافت لیست تغییرات..."
                       FontFamily="KopolFontMedium"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Error State -->
            <VerticalStackLayout IsVisible="{Binding HasError}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="14"
                                 Padding="24">
                <Label Text="{x:Static helpers:KopolArtFaIcons.AlertDanger}"
                       FontFamily="KopolArtFa"
                       FontSize="42"
                       TextColor="{StaticResource StatusRed}"
                       HorizontalOptions="Center" />
                <Label Text="{Binding ErrorMessage}"
                       FontFamily="KopolFontMedium"
                       FontSize="13"
                       LineHeight="1.3"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Button Text="تلاش مجدد"
                        Command="{Binding RetryCommand}"
                        Style="{StaticResource LuxuryPrimaryButtonStyle}"
                        HeightRequest="40"
                        WidthRequest="130"
                        Margin="0,6,0,0" />
            </VerticalStackLayout>

            <!-- Releases Timeline List -->
            <CollectionView ItemsSource="{Binding Releases}"
                            VerticalScrollBarVisibility="Never"
                            SelectionMode="None">
                <CollectionView.Triggers>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding IsLoading}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding HasError}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </CollectionView.Triggers>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:UpdateReleaseDisplayItem">
                        <Border Style="{StaticResource LuxuryCardStyle}"
                                Margin="0,0,0,12"
                                Padding="16">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrentVersion}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>

                            <VerticalStackLayout Spacing="10">

                                <!-- Release Header: Version, Badge & Persian Date -->
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">

                                    <!-- Version Title & Current Version Badge -->
                                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                        <Label Text="{Binding VersionDisplay}"
                                               FontSize="15"
                                               FontFamily="KopolFontBlack"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandAccent}}"
                                               VerticalOptions="Center" />

                                        <Border IsVisible="{Binding IsCurrentVersion}"
                                                BackgroundColor="{StaticResource BrandPrimary}"
                                                StrokeThickness="0"
                                                Padding="8,2"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="نسخه شما"
                                                   FontSize="10"
                                                   TextColor="{StaticResource White}"
                                                   FontFamily="KopolFontBold"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Persian Release Date -->
                                    <HorizontalStackLayout Grid.Column="2"
                                                           Spacing="4"
                                                           IsVisible="{Binding HasDate}"
                                                           VerticalOptions="Center">
                                        <Label Text="{x:Static helpers:KopolArtFaIcons.Calendar}"
                                               FontFamily="KopolArtFa"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding PersianDate}"
                                               FontSize="11.5"
                                               FontFamily="KopolFontMedium"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Divider -->
                                <BoxView Style="{StaticResource CardDividerBoxViewStyle}" />

                                <!-- Release Notes Text -->
                                <Label Text="{Binding ReleaseNotes}"
                                       FontSize="12.5"
                                       FontFamily="KopolFontMedium"
                                       LineHeight="1.45"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
